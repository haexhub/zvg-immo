# Copy to `.env` and fill in real values. `.env` is gitignored.

# Bearer token shared between zvg-immo and haex-claude-proxy so the /settings
# page can drive the proxy's browser-based OAuth flow.
#   openssl rand -hex 32
PROXY_SETUP_TOKEN=

# Password protecting the /settings page (single-user, no email/reset flow).
SETTINGS_PASSWORD=

# HMAC secret for the /settings session cookie. Rotating this logs everyone out.
#   openssl rand -hex 32
SETTINGS_SESSION_SECRET=

# Set to `1` only when this app is unreachable directly and a trusted reverse
# proxy (Traefik, nginx) sits in front — it makes the /settings login rate
# limit key off `x-forwarded-for`. When left empty, the socket peer IP is used
# instead (safer default: a client can't rotate rate-limit buckets by sending
# a spoofed header). If the compose port 3000 is exposed publicly, leave this
# unset.
# NUXT_TRUST_FORWARDED_FOR=1

# Self-hosted Supabase stack (db/auth/rest/kong/meta/studio services in
# docker-compose.yml). Postgres password shared by every role that connects
# to `db` (postgres superuser, authenticator, supabase_auth_admin, ...).
#   openssl rand -hex 32
SUPABASE_DB_PASSWORD=

# HS256 secret GoTrue/PostgREST/Kong all sign and verify JWTs with, plus the
# two static API-key JWTs derived from it (anon/service_role). Generate all
# three together — they must come from the same secret:
#   node scripts/generate-supabase-keys.mjs
SUPABASE_JWT_SECRET=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# External URL the browser uses to reach Kong directly (GoTrue signup/login/
# token-refresh go straight through Kong, not the Nuxt server — see the
# plan's trust-boundary section). Local dev: http://localhost:8000. Prod:
# the public Kong hostname once Traefik routing is wired up (see the
# TODO(traefik) note on the kong service in docker-compose.yml).
SUPABASE_PUBLIC_URL=http://localhost:8000

# App-level mailer for alert emails (server/utils/mailer.ts, nodemailer over
# NUXT_SMTP_URL — see docker-compose.yml's `app` service). Empty → sendMail()
# logs instead of sending, fine for local dev; production needs a real SMTP
# account.
#   SMTP_URL=smtps://user:pass@smtp.example.com:465
SMTP_URL=

# GoTrue's own SMTP (separate from the app mailer above, docker-compose.yml's
# `auth` service) — for GoTrue's own transactional mail, e.g. a future
# "Passwort vergessen" flow. Signup-confirm mail itself stays off in v1
# (GOTRUE_MAILER_AUTOCONFIRM=true in docker-compose.yml).
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_SENDER_NAME=zvg-immo
GOTRUE_SMTP_ADMIN_EMAIL=

# Grafana admin password (grafana service in docker-compose.yml, reachable at
# localhost:3001 — same "tunnel it yourself if needed beyond localhost"
# caution as Studio).
#   openssl rand -hex 32
GRAFANA_ADMIN_PASSWORD=

# G1 Roh-Archiv (WP-3): Supabase Storage bucket for archived crawl
# snapshots (server/utils/raw-archive.ts, storage-uploader.ts, `storage`
# service in docker-compose.yml). Leave empty for local dev — archiving then
# stays local-only (blobs pile up in the outbox, nothing uploads; see
# NUXT_DATABASE_URL above, also required). The bucket itself isn't
# auto-created — create it once in Studio before setting this.
#   STORAGE_BUCKET=zvg-immo-raw-archive
STORAGE_BUCKET=
